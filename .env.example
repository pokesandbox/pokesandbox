# ============================================================
# PokeSandbox — Environment Variables Template
# Copy this file to .env and fill in the values.
# ============================================================

# -------------------------------------------------------
# Database
# Local development (Docker): mongodb://localhost:27017/pokesandbox?replicaSet=rs0
#   (single-node replica set, required for transactions)
# Cloud (production):         mongodb+srv://<user>:<password>@<cluster>/<db>
# -------------------------------------------------------
DATABASE_URI=mongodb://localhost:27017/pokesandbox?replicaSet=rs0

# -------------------------------------------------------
# Discord Bot
# DEV_GUILD_ID: your test server. Commands register there unless
#   NODE_ENV=production, which registers them globally instead; required
#   only outside production.
# -------------------------------------------------------
DISCORD_BOT_TOKEN=
DEV_GUILD_ID=

# -------------------------------------------------------
# Next.js / NextAuth
# AUTH_SECRET: Generate with `openssl rand -base64 32`
# -------------------------------------------------------
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_SECRET=

# -------------------------------------------------------
# Feature flags (see CONTRIBUTING.md#feature-flags)
# NODE_ENV: `production` uses each flag's prod default; anything else
#   (including unset) uses the dev default.
# FEATURE_FLAGS: `*` turns every flag on, `a,b` turns flags on, `-a` turns
#   one off (`*,-a` = everything except a). `*` shows every command locally.
# -------------------------------------------------------
FEATURE_FLAGS=*
