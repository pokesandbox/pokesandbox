{
  "root": true,
  "ignorePatterns": ["**/*"],
  "plugins": ["@nx"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": [],
            "allowCircularSelfDependency": true,
            "depConstraints": [
              {
                "sourceTag": "scope:core",
                "onlyDependOnLibsWithTags": [],
                "bannedExternalImports": [
                  "discord.js",
                  "mongoose",
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "@pokesandbox/pokemon-showdown",
                  "@pokesandbox/pokemon-showdown/*",
                  "pokemon-showdown",
                  "pokemon-showdown/*",
                  "@smogon/*"
                ]
              },
              {
                "sourceTag": "scope:engine",
                "onlyDependOnLibsWithTags": ["scope:core"],
                "bannedExternalImports": [
                  "discord.js",
                  "mongoose",
                  "@pokesandbox/pokemon-showdown",
                  "@pokesandbox/pokemon-showdown/*",
                  "pokemon-showdown",
                  "pokemon-showdown/*",
                  "@smogon/*"
                ]
              },
              {
                "sourceTag": "scope:battle",
                "onlyDependOnLibsWithTags": ["scope:core"],
                "bannedExternalImports": ["discord.js", "mongoose"]
              },
              {
                "sourceTag": "scope:authoring",
                "onlyDependOnLibsWithTags": ["scope:core"],
                "bannedExternalImports": [
                  "discord.js",
                  "mongoose",
                  "@pokesandbox/pokemon-showdown",
                  "@pokesandbox/pokemon-showdown/*",
                  "pokemon-showdown",
                  "pokemon-showdown/*",
                  "@smogon/*"
                ]
              },
              {
                "sourceTag": "scope:presentation",
                "onlyDependOnLibsWithTags": ["scope:core"],
                "bannedExternalImports": [
                  "discord.js",
                  "mongoose",
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "@pokesandbox/pokemon-showdown",
                  "@pokesandbox/pokemon-showdown/*",
                  "pokemon-showdown",
                  "pokemon-showdown/*",
                  "@smogon/*"
                ]
              },
              {
                "sourceTag": "scope:shared",
                "onlyDependOnLibsWithTags": ["scope:core"],
                "bannedExternalImports": [
                  "discord.js",
                  "@pokesandbox/pokemon-showdown",
                  "@pokesandbox/pokemon-showdown/*",
                  "pokemon-showdown",
                  "pokemon-showdown/*",
                  "@smogon/*"
                ]
              },
              {
                "sourceTag": "scope:app-bot",
                "onlyDependOnLibsWithTags": [
                  "scope:core",
                  "scope:engine",
                  "scope:battle",
                  "scope:authoring",
                  "scope:presentation",
                  "scope:shared"
                ]
              },
              {
                "sourceTag": "scope:app-webapp",
                "onlyDependOnLibsWithTags": [
                  "scope:core",
                  "scope:engine",
                  "scope:authoring",
                  "scope:presentation",
                  "scope:shared"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.ts", "*.tsx"],
      "extends": ["plugin:@nx/typescript"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "extends": ["plugin:@nx/javascript"],
      "rules": {}
    },
    {
      "files": ["*.test.ts", "*.test.tsx", "*.test.js", "*.test.jsx"],
      "env": {
        "jest": true
      },
      "rules": {}
    }
  ]
}
