{
  "name": "@pokesandbox/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "setup": "npm run env-setup && npm run db:up && npm run db:seed",
    "start:app": "nx run webapp:dev",
    "start:bot": "nx run bot:serve",
    "env-setup": "node scripts/env-setup.js",
    "db:up": "docker compose up --wait -d",
    "db:down": "docker compose down",
    "db:check": "ts-node --project scripts/tsconfig.json scripts/db/check-transactions.ts",
    "db:indexes": "ts-node --project scripts/tsconfig.json scripts/db/create-indexes.ts",
    "db:seed": "ts-node --project scripts/tsconfig.json scripts/seed/import.ts && npm run db:indexes",
    "db:reset": "npm run db:seed",
    "db:export": "ts-node --project scripts/tsconfig.json scripts/seed/export.ts",
    "erd:generate": "ts-node --project scripts/tsconfig.json scripts/generate-erd.ts",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test --coverage",
    "affected": "nx affected -t lint typecheck test --base=origin/develop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "//devEngines": "runtime.version must match .nvmrc; packageManager matches the npm major that Node version ships. Bump both with .nvmrc.",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^10",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.0",
    "@flowcord/core": "0.1.0-alpha.2",
    "@tanstack/react-query": "^5.90.20",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "antd": "^6.2.2",
    "client-only": "^0.0.1",
    "discord.js": "^14.25.1",
    "intl-messageformat": "^12.1.4",
    "lodash": "^4.17.23",
    "mongoose": "^9.1.5",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "node-cache": "^5.1.2",
    "path": "^0.12.7",
    "pino": "10.4.0",
    "pluralize": "^8.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "tslib": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@flowcord/testing": "^0.1.0-alpha.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nx/devkit": "19.8.0",
    "@nx/esbuild": "19.8.0",
    "@nx/eslint": "19.8.0",
    "@nx/eslint-plugin": "19.8.0",
    "@nx/jest": "19.8.0",
    "@nx/js": "19.8.0",
    "@nx/next": "19.8.0",
    "@nx/node": "19.8.0",
    "@nx/playwright": "19.8.0",
    "@nx/workspace": "19.8.0",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/react": "16.3.2",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.19.12",
    "@types/pluralize": "^0.0.33",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.6",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "autoprefixer": "10.4.20",
    "babel-jest": "^29.7.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.19.12",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-playwright": "^0.15.3",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^15.5.2",
    "nx": "19.8.0",
    "postcss": "8.4.47",
    "prettier": "^3.9.10",
    "sass": "^1.79.3",
    "tailwindcss": "3.4.12",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "~5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  }
}
