{
  "name": "shared",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "shared/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project shared --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p {projectRoot}/tsconfig.lib.json --noEmit",
          "tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
